<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none"
    android:background="@color/canvas">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/pad_screen"
        android:paddingTop="10dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_app"
            android:fontFamily="serif"
            android:textSize="@dimen/text_display"
            android:letterSpacing="-0.02"
            android:textColor="@color/ink" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/app_subtitle"
            android:textSize="@dimen/text_body"
            android:textColor="@color/ink_secondary" />

        <!-- File picker -->
        <LinearLayout
            android:id="@+id/pickApk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_card"
            android:padding="@dimen/pad_card"
            android:clickable="true"
            android:focusable="true"
            android:stateListAnimator="@null">
            <FrameLayout
                android:layout_width="46dp" android:layout_height="46dp"
                android:background="@drawable/bg_surface">
                <ImageView
                    android:layout_width="22dp" android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_doc" android:contentDescription="@null"
                    android:tint="@color/coral" />
            </FrameLayout>
            <LinearLayout
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="14dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/apkFileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/no_file"
                    android:textSize="@dimen/text_body"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/ink" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/pick_apk"
                    android:textSize="@dimen/text_small"
                    android:textColor="@color/coral" />
            </LinearLayout>
            <ImageView
                android:layout_width="20dp" android:layout_height="20dp"
                android:src="@drawable/ic_download" android:contentDescription="@null"
                android:tint="@color/ink_faint" />
        </LinearLayout>

        <!-- Scan button -->
        <TextView
            android:id="@+id/appScanBtn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_button_primary"
            android:gravity="center"
            android:text="@string/scan"
            android:textAllCaps="true"
            android:letterSpacing="0.08"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#FFFFFFFF"
            android:clickable="true"
            android:focusable="true" />

        <!-- Status -->
        <LinearLayout
            android:id="@+id/appStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">
            <ProgressBar
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:indeterminateTint="@color/coral" />
            <TextView
                android:id="@+id/appStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textSize="@dimen/text_body"
                android:textColor="@color/ink_secondary" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Extracts permissions, code strings, URLs, native libs &amp; structure — then AI reasons over the real data to flag backdoors, trackers &amp; data theft."
            android:textSize="@dimen/text_small"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/ink_faint" />
    </LinearLayout>
</ScrollView>
