<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none"
    android:background="@color/canvas">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/pad_screen"
        android:paddingTop="10dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_settings"
            android:fontFamily="serif"
            android:textSize="@dimen/text_display"
            android:letterSpacing="-0.02"
            android:textColor="@color/ink" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/settings_subtitle"
            android:textSize="@dimen/text_body"
            android:textColor="@color/ink_secondary" />

        <!-- API key -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="@dimen/pad_card">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GEMINI API KEY"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:textColor="@color/ink_faint" />
            <EditText
                android:id="@+id/apiInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@null"
                android:hint="@string/api_hint"
                android:textColorHint="@color/ink_faint"
                android:textSize="@dimen/text_body"
                android:textColor="@color/ink"
                android:inputType="textPassword"
                android:singleLine="true" />
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:background="@color/border_strong" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="14dp">
                <TextView
                    android:id="@+id/saveKeyBtn"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_primary"
                    android:gravity="center"
                    android:text="@string/save"
                    android:textColor="#FFFFFFFF"
                    android:textAllCaps="true"
                    android:letterSpacing="0.08"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:clickable="true"
                    android:focusable="true" />
                <TextView
                    android:id="@+id/toggleKeyVisibility"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_button_ghost"
                    android:gravity="center"
                    android:text="👁"
                    android:textSize="16sp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/howToCreateKeyBtn"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_button_soft"
            android:gravity="center"
            android:text="How to create a Gemini API key"
            android:textColor="@color/coral"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:clickable="true"
            android:focusable="true" />

        <!-- Models -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:padding="@dimen/pad_card">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI MODEL"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:textColor="@color/ink_faint" />
            <TextView
                android:id="@+id/modelStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="@dimen/text_small"
                android:textColor="@color/ink_secondary" />
            <TextView
                android:id="@+id/loadModelsBtn"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button_soft"
                android:gravity="center"
                android:text="@string/load_models"
                android:textColor="@color/coral"
                android:textAllCaps="true"
                android:letterSpacing="0.06"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:clickable="true"
                android:focusable="true" />
            <LinearLayout
                android:id="@+id/modelList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- Privacy -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:padding="@dimen/pad_card">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <ImageView
                    android:layout_width="22dp" android:layout_height="22dp"
                    android:src="@drawable/ic_check" android:contentDescription="@null"
                    android:tint="@color/safe" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Auto-cleanup ON"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="@dimen/text_body"
                    android:textColor="@color/ink" />
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Every extracted file — decompiled app data, downloaded page, temp copies — is deleted automatically after each scan produces its report."
                android:textSize="@dimen/text_small"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/ink_faint" />
            <TextView
                android:id="@+id/clearTempBtn"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_button_ghost"
                android:gravity="center"
                android:text="Clear temp files now"
                android:textColor="@color/ink_secondary"
                android:textSize="13sp"
                android:clickable="true"
                    android:focusable="true" />
        </LinearLayout>

        <!-- Links -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:padding="@dimen/pad_card">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LINKS"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:textColor="@color/ink_faint" />
            <TextView
                android:id="@+id/linkWebsite"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button_ghost"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:text="Website"
                android:textColor="@color/coral"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:clickable="true"
                android:focusable="true" />
            <TextView
                android:id="@+id/linkGithub"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_button_ghost"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:text="GitHub Repository"
                android:textColor="@color/coral"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
