<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/canvas">
    <LinearLayout android:id="@+id/chatTopBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:padding="12dp">
        <TextView android:id="@+id/chatBack" android:layout_width="44dp" android:layout_height="44dp" android:gravity="center" android:text="‹" android:textSize="34sp" android:textColor="@color/ink" android:clickable="true" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ask Sentinel" android:fontFamily="serif" android:textSize="22sp" android:textColor="@color/ink" />
            <TextView android:id="@+id/chatStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Evidence-grounded chat" android:textSize="12sp" android:textColor="@color/ink_secondary" />
        </LinearLayout>
    </LinearLayout>
    <ScrollView android:id="@+id/chatScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:paddingHorizontal="16dp" android:scrollbars="none">
        <LinearLayout android:id="@+id/chatMessages" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="14dp" />
    </ScrollView>
    <LinearLayout android:id="@+id/chatComposer" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="10dp" android:gravity="center_vertical" android:background="@color/surface_alt">
        <EditText android:id="@+id/chatInput" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="Ask about this scan…" android:inputType="textCapSentences|textMultiLine" android:maxLines="4" android:background="@drawable/bg_input" android:padding="12dp" android:textColor="@color/ink" android:textColorHint="@color/ink_faint" />
        <TextView android:id="@+id/chatSend" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:padding="12dp" android:text="SEND" android:textStyle="bold" android:textColor="@color/coral" android:clickable="true" android:focusable="true" />
    </LinearLayout>
</LinearLayout>
